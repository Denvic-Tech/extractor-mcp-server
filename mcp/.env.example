# Скопируйте в .env и заполните. Файл .env НЕ коммитить (см. .gitignore).
# Переменные MCP-сервера (префикс EXTRACTOR_PROJECTS_, см. ApiSettings).

# Базы 1С и их учётные данные задаются отдельно в закрытом bases.yaml.
# Скопируйте bases.example.yaml в bases.yaml и заполните подключения.
EXTRACTOR_PROJECTS_TRANSPORT=direct_http
EXTRACTOR_PROJECTS_BASES_FILE=bases.yaml
# EXTRACTOR_PROJECTS_DEFAULT_BASE_ID=erp

# Bearer-токены для MCP-эндпоинта. Один или несколько через запятую, можно
# в виде "label:token" (метка только для читаемости, сверяется сам токен).
# Пусто = сервер отвечает 503 на всё, кроме /health (fail-closed).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ОБЯЗАТЕЛЬНО задайте свой токен перед публикацией наружу.
EXTRACTOR_PROJECTS_MCP_TOKENS=

# Таймаут HTTP, сек.
EXTRACTOR_PROJECTS_TIMEOUT=60

# Разрешить HTTP вместо HTTPS — только для локального dev. По умолчанию false.
# EXTRACTOR_PROJECTS_ALLOW_HTTP_DEV=false

# Постоянное хранилище preview-планов и ключей идемпотентности.
# Локально: рабочий каталог mcp/. Compose задаёт свой путь внутри volume.
EXTRACTOR_PROJECTS_OPERATION_DB=state/operations.sqlite3
# EXTRACTOR_PROJECTS_PLAN_TTL_SECONDS=900

# Необязательные параметры доверия/mTLS при обращении MCP к API 1С.
# EXTRACTOR_PROJECTS_CA_BUNDLE=/run/extractor1c-certs/ca.pem
# EXTRACTOR_PROJECTS_CLIENT_CERT=/run/extractor1c-certs/client.pem
# EXTRACTOR_PROJECTS_CLIENT_KEY=/run/extractor1c-certs/client.key

# Host заголовок внешнего MCP (например, extractor.example.ru).
# EXTRACTOR_PROJECTS_ALLOWED_HOSTS=extractor.example.ru

# Альтернативный транспорт: базы DCC v2 с поддержкой контракта MCP-задач.
# При выборе dcc замените TRANSPORT выше и уберите BASES_FILE.
# EXTRACTOR_PROJECTS_TRANSPORT=dcc
# EXTRACTOR_PROJECTS_DCC_URL=https://dcc.example.test
# EXTRACTOR_PROJECTS_DCC_USER=mcp
# EXTRACTOR_PROJECTS_DCC_PASSWORD=
# EXTRACTOR_PROJECTS_DCC_WAIT_TIMEOUT=60
# EXTRACTOR_PROJECTS_DCC_POLL_INTERVAL=1
