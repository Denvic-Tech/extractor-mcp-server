# Пример настроек MCP для прямого подключения к 1С.
# Скопируйте в .env, а bases.example.yaml — в bases.yaml.
# Замените заглушки адреса и учётных данных в bases.yaml и токен ниже.
# Рабочие .env и bases.yaml не публикуйте и не добавляйте в Git.

# Прямое подключение к базам из bases.yaml.
EXTRACTOR_PROJECTS_TRANSPORT=direct_http
EXTRACTOR_PROJECTS_BASES_FILE=bases.yaml
# Должно совпадать с base_id выбранной базы в bases.yaml.
EXTRACTOR_PROJECTS_DEFAULT_BASE_ID=erp

# Доступ ИИ-клиентов к MCP по HTTP.
# Замените заглушку случайным токеном. Префикс Bearer здесь не нужен.
# В клиенте используйте заголовок Authorization: Bearer <ваш токен>.
# Для подключения через stdio этот токен не используется.
EXTRACTOR_PROJECTS_MCP_TOKENS=REPLACE_WITH_RANDOM_MCP_TOKEN

# Подключение к 1С по HTTPS. HTTP допускается только для разработки.
EXTRACTOR_PROJECTS_ALLOW_HTTP_DEV=false
# Тайм-аут отдельного HTTP-запроса, в секундах.
EXTRACTOR_PROJECTS_TIMEOUT=60

# Постоянное хранилище планов и операций. Сохраняйте при обновлении MCP.
EXTRACTOR_PROJECTS_OPERATION_DB=state/operations.sqlite3
# Срок действия предварительного плана, в секундах.
EXTRACTOR_PROJECTS_PLAN_TTL_SECONDS=900

# Для обычного HTTPS оставьте пустыми.
# При необходимости укажите PEM-файл доверенных CA.
EXTRACTOR_PROJECTS_CA_BUNDLE=
# При mTLS укажите клиентский сертификат и ключ вместе.
EXTRACTOR_PROJECTS_CLIENT_CERT=
EXTRACTOR_PROJECTS_CLIENT_KEY=
